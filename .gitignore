# ==========================================
# Vitralis - Stained Glass Studio .gitignore
# ==========================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Production & Build Outputs
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# 3. Environment & Local Configs
.env
.env.*
!.env.example
*.local

# 4. Testing & Coverage
coverage/
*.lcov
.nyc_output/

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. IDEs & Code Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# 7. OS & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Hallmark & Agent Runtime Caches
.hallmark/
